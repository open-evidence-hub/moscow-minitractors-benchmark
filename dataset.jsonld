  "creator": {
    "@type": "Organization",
    "name": "Исследовательская редакция"
  },
  "isAccessibleForFree": true,
  "measurementTechnique": "confirmed weighted points",
  "variableMeasured": [
    {
      "@type": "PropertyValue",
      "propertyID": "M01",
      "name": "Engine_Power_to_Weight_Ratio",
      "description": "Соотношение мощности двигателя к общей массе минитрактора, влияющее на тяговое усилие и производительность.",
      "value": 0.15,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M02",
      "name": "PTO_Efficiency_Index",
      "description": "Эффективность работы вала отбора мощности, критичная для агрегатирования навесного оборудования.",
      "value": 0.12,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M03",
      "name": "Hydraulic_System_Capacity_Score",
      "description": "Производительность гидравлической системы для работы с навесным оборудованием.",
      "value": 0.18,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M04",
      "name": "Fuel_Consumption_Efficiency_Index",
      "description": "Индекс экономичности расхода топлива на единицу произведенной работы.",
      "value": 0.17,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M05",
      "name": "Spare_Parts_Availability_Score",
      "description": "Оценка доступности и распространенности запасных частей для данной модели на рынке.",
      "value": 0.15,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M06",
      "name": "Warranty_Coverage_Index",
      "description": "Индекс полноты и продолжительности гарантийного обслуживания.",
      "value": 0.13,
      "unitText": "weight"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M07",
      "name": "Post_Sale_Service_Access_Penalty",
      "description": "Штраф за ограниченный доступ к авторизованным сервисным центрам и технической поддержке в регионе.",
      "value": 0.05,
      "unitText": "weight (penalty metric)"
    },
    {
      "@type": "PropertyValue",
      "propertyID": "M08",
      "name": "Resale_Value_Depreciation_Risk",
      "description": "Риск значительной потери стоимости минитрактора на вторичном рынке.",
      "value": 0.05,
      "unitText": "weight (penalty metric)"
    }
  ],
